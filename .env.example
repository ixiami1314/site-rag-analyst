# ===========================================================================
# site-rag-analyst configuration
# Copy to .env and adjust. With NO changes (and no API keys) the app runs in
# demo mode: offline TF-IDF embeddings + a deterministic mock analyst.
# ===========================================================================

# --- Analysis LLM: any OpenAI-compatible /chat/completions endpoint -------
# Leave empty to stay in demo mode. Works with OpenAI, OpenRouter, LiteLLM,
# or any gateway that serves Claude models behind an OpenAI-compatible API.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Embeddings -------------------------------------------------------------
# auto: real embeddings when a key+endpoint exist, TF-IDF otherwise.
EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Crawling ---------------------------------------------------------------
CRAWL_MAX_PAGES=25
CRAWL_MAX_DEPTH=2
CRAWL_DELAY_SECONDS=1.0
RESPECT_ROBOTS=true

# --- Chunking ---------------------------------------------------------------
CHUNK_TARGET_WORDS=280
CHUNK_OVERLAP_WORDS=45

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=6

# --- Storage ----------------------------------------------------------------
DATA_DIR=./data
OUTPUT_DIR=./output

# --- Service ----------------------------------------------------------------
# Set false on public deployments to disable /docs, /redoc and /openapi.json.
DOCS_ENABLED=true
